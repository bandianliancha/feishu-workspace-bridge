{
  "name": "dsh-plugin-feishu-workspace",
  "version": "0.3.0",
  "description": "One private Feishu group per DSH workspace with real-time two-way message synchronization.",
  "type": "module",
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "client.js",
    "store.mjs",
    "secret-store.mjs",
    "tools.mjs",
    "bridge.mjs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "feishu",
    "lark",
    "bot",
    "agent",
    "collaboration"
  ],
  "author": "bandianliancha",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bandianliancha/feishu-workspace-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/bandianliancha/feishu-workspace-bridge/issues"
  },
  "homepage": "https://github.com/bandianliancha/feishu-workspace-bridge#readme",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.7 || ^0.1.2-alpha.1"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.60.0",
    "better-sqlite3": "^12.4.1"
  },
  "devDependencies": {},
  "scripts": {
    "test": "node test-bind-bot.mjs && node test-lazy-sync.mjs && node test-session-forwarder.mjs && node test-workspace-member.mjs && node test-store-security.mjs && node test-secret-migration.mjs && node test-delivery-e2e.mjs",
    "check": "node --check index.mjs && node --check bridge.mjs && node --check store.mjs && node --check tools.mjs && npm test"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
